---
import { getTurma, getTema } from "../lib/dados.js";
import AvisoDemonstracao from "./AvisoDemonstracao.astro";
import CarrosselCapa from "./CarrosselCapa.astro";

const { projeto, compacto = false } = Astro.props;
const turma = getTurma(projeto.turmaId);
const responsavel =
  projeto.categoria === "turma" ? turma?.rotulo : projeto.professorResponsavel;
const categoria = projeto.categoria === "turma" ? "Turma" : "Educadores";
const temas = projeto.temas.map((id) => getTema(id)).filter(Boolean);
const temFotos = projeto.imagens.length > 0;
const temVideos = projeto.videos.length > 0;
const href = `/projetos/${projeto.slug}/`;
---

<article class="cartao">
<a class="capa" href={href} tabindex="-1" aria-hidden="true">
  {projeto.slug === "abertura-solene-letramento-racial" || projeto.id === "educador-001" ? (
    <CarrosselCapa
      imagens={[
        {
          src: "/images/projetos/educadores/abertura-solene-letramento-racial/banda1.jpeg",
          alt: "Banda convidada se apresentando no evento",
        },
        {
          src: "/images/projetos/educadores/abertura-solene-letramento-racial/slideCapa.jpeg",
          alt: "Capa do projeto Abertura solene do Projeto Letramento Racial",
        },
      ]}
      mostrarControles={false}
    />
  ) : projeto.imagemCapa ? (
    <img
      src={projeto.imagemCapa}
      alt={projeto.imagemCapaAlt}
      loading="lazy"
      width="640"
      height="400"
    />
  ) : (
    <div class="sem-capa">Sem imagem de capa</div>
  )}
</a>
  <div class:list={["corpo", { "corpo--compacto": compacto }]}>
    {!compacto && (
      <p class="meta">
        <strong>{categoria}</strong>
        {responsavel && <span> | {responsavel}</span>}
        <span> | {projeto.ano}</span>
      </p>
    )}
    <h3><a href={href}>{projeto.titulo}</a></h3>
    {!compacto && <p>{projeto.descricao}</p>}
    {temas.length > 0 && (
      <p class="temas">
        {temas.map((t) => <span>{t.nome}</span>)}
      </p>
    )}
    {!compacto && (
      <p class="midia">
        {temFotos && <span>Fotografias</span>}
        {temVideos && <span>Vídeos</span>}
      </p>
    )}
    {projeto.demonstracao && <AvisoDemonstracao />}
    {compacto && (
      <a href={href} class="btn-ver-projeto" aria-label={`Ver projeto: ${projeto.titulo}`}>
        Ver projeto
      </a>
    )}
  </div>
</article>

<style>
  .cartao {
    background: var(--branco);
    border-radius: var(--raio);
    overflow: hidden;
    border: 1px solid rgb(51 40 33 / 0.15);
    display: flex;
    flex-direction: column;
  }
  .capa img,
  .sem-capa {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .sem-capa {
    display: grid;
    place-items: center;
    background: var(--bege);
    color: var(--marrom);
    font-size: 0.95rem;
  }
  .corpo { padding: 1rem; }
  .corpo--compacto {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .corpo--compacto .temas { justify-content: center; }
  .meta { font-size: 0.9rem; margin-bottom: 0.4rem; }
  .cartao h3 { margin-bottom: 0.5rem; }
  .cartao h3 a { color: var(--marrom); text-decoration: none; }
  .cartao h3 a:hover { text-decoration: underline; }
  .temas, .midia { display: flex; flex-wrap: wrap; gap: 0.4rem; font-size: 0.85rem; margin-bottom: 0.6rem; }
  .temas span { border: 1px solid var(--terracota); color: var(--terracota); border-radius: 0.75rem; padding: 0.1rem 0.6rem; }
  .midia span { background: var(--bege); border-radius: 0.75rem; padding: 0.1rem 0.6rem; }
  .btn-ver-projeto {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.45rem 1.1rem;
    background: var(--terracota);
    color: var(--branco);
    border-radius: var(--raio);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s;
  }
  .btn-ver-projeto:hover {
    background: var(--marrom);
    transform: scale(1.03);
  }
  .btn-ver-projeto:focus-visible {
    outline: 3px solid var(--marrom);
    outline-offset: 2px;
  }
</style>