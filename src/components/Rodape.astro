---
const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="container barra">

    <div class="identidade">
      <strong>Letramento Racial na Escola</strong>
      <span>E. E. Profª Carolina Cintra da Silveira</span>
    </div>

    <nav aria-label="Navegação rápida">
      <ul>
        <li><a href="/">Início</a></li>
        <li><a href="/projetos/">Projetos</a></li>
        <li><a href="/sobre/">Sobre</a></li>
        <li><a href="/referencias/">Referências</a></li>
        <li><a href="/privacidade/">Privacidade</a></li>
      </ul>
    </nav>

    <p class="assinatura">
      {ano} &#9734; Feito com amor pelo <a href="https://www.instagram.com/3bds.terceirao/">3ºB DS</a>
    </p>

  </div>
</footer>

<style>
  .rodape {
    background: var(--marrom);
    color: var(--bege);
    border-top: 4px solid var(--ocre);
    padding-block: 1rem;
  }
  .rodape a { color: var(--ocre); }
  .rodape :focus-visible { outline-color: var(--ocre); }

  /* Layout da barra */
  .barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  /* Identidade */
  .identidade {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    font-size: 0.9rem;
    line-height: 1.35;
  }
  .identidade strong {
    font-size: 1rem;
  }

  /* Navegação em linha */
  .rodape nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .rodape nav a {
    font-size: 0.88rem;
    white-space: nowrap;
  }

  /* Assinatura */
  .assinatura {
    font-size: 0.85rem;
    white-space: nowrap;
  }
</style>