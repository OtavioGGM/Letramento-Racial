---
import Base from "../layouts/Base.astro";
---

<Base
  titulo="Página não encontrada"
  descricao="A página solicitada não foi encontrada no portal Letramento Racial na Escola."
>
  <section class="secao centro-404">
    <div class="container estreito">
      <p class="codigo-404">404</p>
      <h1>Página não encontrada</h1>
      <p class="mensagem">
        O endereço que você tentou acessar não existe, foi movido ou está temporariamente indisponível.
      </p>
      <div class="acoes">
        <a class="botao" href="/">Ir para a página inicial</a>
        <a class="botao botao--contorno" href="/projetos/">Ver o acervo de projetos</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .centro-404 {
    padding-block: 5rem;
    text-align: center;
  }
  .estreito {
    max-width: 38rem;
  }
  .codigo-404 {
    font-family: var(--fonte-titulo);
    font-size: clamp(4rem, 15vw, 7rem);
    font-weight: 700;
    color: var(--terracota);
    margin: 0;
    line-height: 1;
  }
  h1 {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  .mensagem {
    font-size: 1.2rem;
    color: var(--marrom);
    margin-bottom: 2rem;
  }
  .acoes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  @media (max-width: 36em) {
    .acoes .botao {
      width: 100%;
    }
  }
</style>
