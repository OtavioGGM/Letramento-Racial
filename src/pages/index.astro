---
import Base from "../layouts/Base.astro";
import CartaoProjeto from "../components/CartaoProjeto.astro";
import { projetosDestaque } from "../lib/dados.js";
---

<Base imagem="/images/banner.webp">
  <section class="banner">
    <div class="container">
      <h1>Letramento Racial na Escola</h1>
      <p class="destaque">Conhecer a história, reconhecer as desigualdades e construir uma sociedade antirracista.</p>
      <p>Projeto da E. E. Profª Carolina Cintra da Silveira, inspirado no livro Pequeno Manual Antirracista, de Djamila Ribeiro.</p>
      <a class="botao botao--claro" href="/projetos/">Conheça nossos projetos</a>
    </div>
  </section>

  <section class="secao fundo-branco">
    <div class="container estreito">
      <h2>Sobre o projeto</h2>
      <p>A escola é um espaço de formação humana, cidadã e social. O projeto leva os estudantes a compreender como o racismo se constituiu historicamente no Brasil e como continua presente nas estruturas sociais e nas relações do dia a dia.</p>
      <a class="botao botao--contorno" href="/sobre/">Conheça o projeto completo</a>
    </div>
  </section>

  <section class="secao">
     <div class="container duas-colunas">
    <img class="imagem-destaque imagem-scroll" src="/images/livro/capa.webp" alt="Capa do livro Pequeno Manual Antirracista" width="360" height="540" />
      <div>
        <h2>Nossa inspiração literária</h2>
        <p><strong>Pequeno Manual Antirracista</strong>, de Djamila Ribeiro.</p>
        <p>A obra é a base teórica do projeto. O capítulo sobre as bases históricas do racismo no Brasil questiona a ideia da população negra como vítima passiva da escravidão e mostra que seus efeitos continuam presentes na sociedade.</p>
        <p class="ref">RIBEIRO, Djamila. <em>Pequeno manual antirracista</em>. São Paulo: Companhia das Letras, 2019.</p>
        <a class="botao botao--contorno" href="/referencias/">Ver referências</a>
      </div>
    </div>
  </section>

  <section class="secao fundo-branco">
    <div class="container duas-colunas">
      <!-- TROCAR: fotografia autorizada em /images/autora/ -->
       <img class="imagem-destaque imagem-scroll" src="/images/autora/djamila.webp" alt="Fotografia de Djamila Ribeiro" width="360" height="480" />
      <div>
        <h2>Sobre a autora</h2>
        <p><strong>Djamila Ribeiro</strong> é filósofa, escritora e ativista brasileira, autora de livros sobre feminismo negro, relações raciais e filosofia política, como Pequeno Manual Antirracista (2019) e O que é lugar de fala? (2017).</p>
        <p><em>Oriunda de uma família trabalhadora de Santos (SP), teve sua formação marcada por duas grandes influências familiares: o pai, sindicalista e militante do movimento negro, despertou nela o interesse pela leitura e a consciência política; já a mãe e a avó foram responsáveis por transmitir-lhe as tradições e vivências espirituais do candomblé.</em></p>
        <p class="ref">Divulgação/Flavio Teperman. <em>O mergulho ancestral de Djamila Ribeiro</em>. Revista ELLE, 2021.</p>
        <a class="botao botao--contorno" href="https://elle.com.br/cultura/o-mergulho-ancestral-de-djamila-ribeiro">Ver referências</a>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="container">
      <h2>Projetos em destaque</h2>
      <div class="grade-cartoes">
        {projetosDestaque.map((p) => <CartaoProjeto projeto={p} />)}
      </div>
      <p class="centro"><a class="botao" href="/projetos/">Ver todos os projetos</a></p>
    </div>
  </section>
</Base>

<style>
  .banner {
    background-color: var(--verde);
    background-image:
      linear-gradient(rgba(51, 40, 33, 0.78), rgba(51, 40, 33, 0.78)),
      url("/images/banner.webp");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: var(--bege);
    padding-block: 2.5rem;
    border-bottom: 6px solid var(--ocre);
  }
  .banner .destaque {
    font-family: var(--fonte-titulo);
    font-size: clamp(1.1rem, 3vw, 1.45rem);
    max-width: 38rem;
  }
  .banner p { max-width: 38rem; }
  .botao--claro {
    background: var(--ocre);
    border-color: var(--ocre);
    color: var(--marrom);
  }
  .botao--claro:hover { background: var(--bege); border-color: var(--bege); color: var(--marrom); }
  .banner :global(:focus-visible) { outline-color: var(--ocre); }

  /* Elementos responsivos mobile-first nos botões */
  .banner .botao,
  .duas-colunas .botao,
  .estreito .botao {
    width: 100%;
    max-width: 22rem;
    text-align: center;
  }

  .estreito { max-width: 46rem; }
  .fundo-branco { background: var(--branco); }

  .duas-colunas {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }

  /* Imagem mobile-first: dimensões proporcionais e centralizada em telas pequenas */
  .imagem-destaque {
    width: 100%;
    max-width: 17.5rem;
    margin-inline: auto;
    border-radius: var(--raio);
    box-shadow: 0 4px 16px rgb(51 40 33 / 0.12);
    transform-origin: center center;
    will-change: transform;
    transition: transform 0.15s ease-out;
  }

  /* Animação acionada pelo scroll: a imagem diminui suavemente conforme o scroll avança */
  @keyframes diminuir-scroll {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(0.85);
    }
  }

  @supports (animation-timeline: view()) {
    .imagem-scroll {
      animation: diminuir-scroll linear both;
      animation-timeline: view();
      animation-range: entry 15% exit 85%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .imagem-scroll {
      animation: none !important;
      transform: none !important;
    }
  }

  .imagem-pendente {
    display: grid;
    place-items: center;
    text-align: center;
    min-height: 16rem;
    padding: 1rem;
    border: 2px dashed var(--terracota);
    border-radius: var(--raio);
    background: var(--bege);
    font-size: 0.95rem;
  }
  .ref { font-size: 0.95rem; }

  .grade-cartoes { display: grid; gap: 1.25rem; }
  .centro { text-align: center; margin-top: 2rem; }

  @media (min-width: 48em) {
    .banner {
      padding-block: 4rem;
    }
    .banner .botao,
    .duas-colunas .botao,
    .estreito .botao {
      width: auto;
      max-width: none;
    }
    .duas-colunas {
      grid-template-columns: 1fr 1.5fr;
      gap: 2.5rem;
    }
    .imagem-destaque {
      max-width: 100%;
      margin-inline: 0;
    }
    .grade-cartoes {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 64em) {
    .grade-cartoes {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
  if (typeof window !== "undefined" && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    if (!("animationTimeline" in document.documentElement.style)) {
      const imagens = document.querySelectorAll(".imagem-scroll");
      if (imagens.length > 0) {
        let emExecucao = false;

        const atualizarEscala = () => {
          const alturaJanela = window.innerHeight;
          imagens.forEach((el) => {
            const rect = el.getBoundingClientRect();
            if (rect.bottom > 0 && rect.top < alturaJanela) {
              const progresso = Math.min(
                Math.max((alturaJanela - rect.top) / (alturaJanela + rect.height), 0),
                1
              );
              const escala = 1 - progresso * 0.15;
              el.style.transform = `scale(${escala.toFixed(3)})`;
            }
          });
          emExecucao = false;
        };

        window.addEventListener(
          "scroll",
          () => {
            if (!emExecucao) {
              window.requestAnimationFrame(atualizarEscala);
              emExecucao = true;
            }
          },
          { passive: true }
        );

        atualizarEscala();
      }
    }
  }
</script>